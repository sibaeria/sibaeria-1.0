<!DOCTYPE html>
<html lang="it">
<head>
<meta charset="UTF-8">

<meta
  name="viewport"
  content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no"
>

<meta name="theme-color" content="#f3f3f1">

<title>Players</title>

<style>

:root {
  --background: #f3f3f1;
  --foreground: #151515;
  --muted: #8c8c88;
  --line: #d8d8d4;
  --surface: #eeeeeb;
  --surface-hover: #e7e7e3;

  --radius: 14px;
  --transition: 180ms cubic-bezier(.22, 1, .36, 1);
}

* {
  box-sizing: border-box;
}

html {
  width: 100%;
  min-height: 100%;
  background: var(--background);
  color: var(--foreground);
  overscroll-behavior: none;
}

body {
  width: 100%;
  min-height: 100dvh;
  margin: 0;

  background: var(--background);
  color: var(--foreground);

  font-family:
    Inter,
    -apple-system,
    BlinkMacSystemFont,
    "Segoe UI",
    sans-serif;

  -webkit-font-smoothing: antialiased;
  text-rendering: optimizeLegibility;

  overscroll-behavior: none;
  user-select: none;
}

button,
input {
  font: inherit;
  -webkit-tap-highlight-color: transparent;
}

button {
  color: inherit;
}


/* =========================================
   APP
========================================= */

.app {
  width: min(100%, 760px);
  min-height: 100dvh;

  margin: 0 auto;

  padding:
    max(22px, env(safe-area-inset-top))
    22px
    max(22px, env(safe-area-inset-bottom))
    22px;

  display: flex;
  flex-direction: column;
}


/* =========================================
   TOP BAR
========================================= */

.topbar {
  display: grid;
  grid-template-columns: 42px 1fr 42px;
  align-items: center;
  gap: 10px;

  margin-bottom: 28px;
}

.icon-button {
  width: 42px;
  height: 42px;

  padding: 0;

  border: 1px solid var(--line);
  border-radius: var(--radius);

  background: var(--surface);

  display: grid;
  place-items: center;

  font-size: 18px;

  cursor: pointer;

  transition:
    transform var(--transition),
    background var(--transition),
    border-color var(--transition);
}

.icon-button:hover {
  background: var(--surface-hover);
  border-color: #c9c9c5;
}

.icon-button:active {
  transform: scale(.94);
}

.title-input {
  width: 100%;
  height: 42px;

  padding: 0 14px;

  border: 1px solid transparent;
  border-radius: var(--radius);

  outline: none;

  background: transparent;

  text-align: center;

  font-size: 14px;
  font-weight: 500;

  transition:
    background var(--transition),
    border-color var(--transition);
}

.title-input:focus {
  background: var(--surface);
  border-color: var(--line);
}


/* =========================================
   PLAYERS
========================================= */

.players {
  display: flex;
  flex-direction: column;
  gap: 52px;

  flex: 1;
}

.player {
  display: flex;
  flex-direction: column;
  align-items: center;

  animation:
    playerIn .5s cubic-bezier(.22, 1, .36, 1);
}

@keyframes playerIn {

  from {
    opacity: 0;
    transform: translateY(8px);
  }

  to {
    opacity: 1;
    transform: translateY(0);
  }

}

.player-name {
  margin-bottom: 8px;

  font-size: 12px;
  font-weight: 600;

  letter-spacing: .08em;

  color: var(--muted);
}

.score {
  min-height: 92px;

  display: flex;
  align-items: center;

  font-size: clamp(62px, 16vw, 110px);
  line-height: .95;

  font-weight: 500;

  letter-spacing: -.065em;

  font-variant-numeric: tabular-nums;

  transition:
    transform 220ms cubic-bezier(.22, 1, .36, 1),
    opacity 180ms ease;
}

.score.bump {
  animation:
    scoreBump 260ms cubic-bezier(.22, 1, .36, 1);
}

@keyframes scoreBump {

  0% {
    transform: scale(1);
  }

  45% {
    transform: scale(1.045);
  }

  100% {
    transform: scale(1);
  }

}


/* =========================================
   AMOUNT CONTROL
========================================= */

.amount-control {
  width: min(100%, 260px);
  height: 44px;

  margin-top: 22px;

  display: grid;
  grid-template-columns: 44px 1fr 44px;

  border: 1px solid var(--line);
  border-radius: var(--radius);

  overflow: hidden;

  background: var(--surface);
}

.amount-button {
  border: 0;

  background: transparent;

  font-size: 21px;
  font-weight: 400;

  cursor: pointer;

  transition:
    background var(--transition),
    transform var(--transition);
}

.amount-button:hover {
  background: var(--surface-hover);
}

.amount-button:active {
  transform: scale(.9);
}

.amount-input {
  width: 100%;
  min-width: 0;

  border: 0;

  border-left: 1px solid var(--line);
  border-right: 1px solid var(--line);

  outline: 0;

  background: transparent;

  text-align: center;

  color: var(--foreground);

  font-size: 13px;
  font-weight: 500;

  appearance: textfield;
  -moz-appearance: textfield;
}

.amount-input::-webkit-inner-spin-button,
.amount-input::-webkit-outer-spin-button {
  -webkit-appearance: none;
  margin: 0;
}

.amount-input:focus {
  background: rgba(255,255,255,.25);
}


/* =========================================
   TOOLS
========================================= */

.tools {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8px;

  margin-top: 46px;
}

.tool-button {
  height: 48px;

  border: 1px solid var(--line);
  border-radius: var(--radius);

  background: var(--surface);

  cursor: pointer;

  display: grid;
  place-items: center;

  transition:
    transform var(--transition),
    background var(--transition),
    border-color var(--transition);
}

.tool-button:hover {
  background: var(--surface-hover);
  border-color: #c9c9c5;
}

.tool-button:active {
  transform: scale(.94);
}

.tool-icon {
  font-size: 19px;
  line-height: 1;
}


/* =========================================
   OVERLAY
========================================= */

.overlay {
  position: fixed;
  inset: 0;

  z-index: 100;

  padding: 20px;

  display: grid;
  place-items: center;

  background: rgba(243,243,241,.76);

  backdrop-filter: blur(12px);
  -webkit-backdrop-filter: blur(12px);

  opacity: 0;
  visibility: hidden;

  transition:
    opacity 220ms ease,
    visibility 220ms ease;
}

.overlay.open {
  opacity: 1;
  visibility: visible;
}


/* =========================================
   MODAL
========================================= */

.game-modal {
  position: relative;

  width: min(100%, 360px);

  padding: 26px;

  border: 1px solid var(--line);
  border-radius: 20px;

  background: var(--background);

  box-shadow:
    0 20px 60px rgba(0,0,0,.08);

  transform:
    translateY(12px)
    scale(.97);

  transition:
    transform 300ms cubic-bezier(.22,1,.36,1);
}

.overlay.open .game-modal {
  transform:
    translateY(0)
    scale(1);
}

.modal-close {
  position: absolute;

  top: 12px;
  right: 12px;

  width: 32px;
  height: 32px;

  border: 0;
  border-radius: 50%;

  background: transparent;

  font-size: 22px;
  font-weight: 300;

  cursor: pointer;

  transition:
    background var(--transition),
    transform var(--transition);
}

.modal-close:hover {
  background: var(--surface);
}

.modal-close:active {
  transform: scale(.88);
}

.modal-title {
  text-align: center;

  font-size: 11px;
  font-weight: 700;

  letter-spacing: .12em;

  color: var(--muted);
}


/* =========================================
   DICE
========================================= */

.dice-scene {
  width: 140px;
  height: 140px;

  margin: 38px auto 18px;

  display: grid;
  place-items: center;

  perspective: 700px;
}

.dice {
  position: relative;

  width: 72px;
  height: 72px;

  transform-style: preserve-3d;

  transition:
    transform 900ms cubic-bezier(.15,.85,.25,1);
}

.dice-face {
  position: absolute;

  width: 72px;
  height: 72px;

  display: grid;
  place-items: center;

  border: 1px solid #cfcfca;
  border-radius: 13px;

  background: var(--surface);

  font-size: 31px;

  backface-visibility: hidden;
}

.dice-front {
  transform: translateZ(36px);
}

.dice-back {
  transform:
    rotateY(180deg)
    translateZ(36px);
}

.dice-right {
  transform:
    rotateY(90deg)
    translateZ(36px);
}

.dice-left {
  transform:
    rotateY(-90deg)
    translateZ(36px);
}

.dice-top {
  transform:
    rotateX(90deg)
    translateZ(36px);
}

.dice-bottom {
  transform:
    rotateX(-90deg)
    translateZ(36px);
}


/* =========================================
   COIN
========================================= */

.coin-scene {
  width: 150px;
  height: 150px;

  margin: 30px auto 18px;

  display: grid;
  place-items: center;

  perspective: 900px;
}

.coin {
  position: relative;

  width: 88px;
  height: 88px;

  transform-style: preserve-3d;

  transition:
    transform 1.15s cubic-bezier(.16,.84,.27,1);
}

.coin-side {
  position: absolute;

  inset: 0;

  border-radius: 50%;

  border: 1px solid #c7c7c2;

  background: var(--surface);

  display: grid;
  place-items: center;

  font-size: 26px;
  font-weight: 600;

  backface-visibility: hidden;
}

.coin-heads {
  transform: translateZ(5px);
}

.coin-tails {
  transform:
    rotateY(180deg)
    translateZ(5px);
}


/* =========================================
   RESULTS
========================================= */

.result {
  min-height: 36px;

  margin-bottom: 22px;

  text-align: center;

  font-size: 18px;
  font-weight: 500;

  font-variant-numeric: tabular-nums;
}

.large-result {
  min-height: 72px;

  display: grid;
  place-items: center;

  font-size: 58px;

  letter-spacing: -.05em;
}


/* =========================================
   PRIMARY BUTTON
========================================= */

.primary-button {
  width: 100%;
  height: 46px;

  border: 1px solid var(--line);
  border-radius: var(--radius);

  background: var(--surface);

  font-size: 11px;
  font-weight: 700;

  letter-spacing: .08em;

  cursor: pointer;

  transition:
    background var(--transition),
    transform var(--transition);
}

.primary-button:hover {
  background: var(--surface-hover);
}

.primary-button:active {
  transform: scale(.97);
}

.primary-button:disabled {
  cursor: default;
  opacity: .5;
}


/* =========================================
   RANDOM
========================================= */

.random-settings {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 10px;

  margin-top: 30px;
}

.number-field {
  display: flex;
  flex-direction: column;
  gap: 7px;
}

.number-field label {
  font-size: 9px;
  font-weight: 700;

  color: var(--muted);

  letter-spacing: .08em;
}

.number-field input,
.edit-fields input {
  width: 100%;
  height: 42px;

  padding: 0 12px;

  border: 1px solid var(--line);
  border-radius: var(--radius);

  outline: 0;

  background: var(--surface);

  text-align: center;
}

.number-field input:focus,
.edit-fields input:focus {
  border-color: #bdbdb8;
}


/* =========================================
   EDIT
========================================= */

.edit-fields {
  display: flex;
  flex-direction: column;
  gap: 14px;

  margin: 28px 0 22px;
}

.edit-fields label {
  display: flex;
  flex-direction: column;
  gap: 7px;

  font-size: 9px;
  font-weight: 700;

  color: var(--muted);

  letter-spacing: .08em;
}

.edit-fields input {
  text-align: left;
  font-size: 13px;
}


/* =========================================
   MOBILE
========================================= */

@media (max-width:500px) {

  .app {
    padding:
      max(16px,env(safe-area-inset-top))
      16px
      max(16px,env(safe-area-inset-bottom))
      16px;
  }

  .topbar {
    margin-bottom: 20px;
  }

  .players {
    gap: 42px;
  }

  .score {
    font-size:
      clamp(58px,19vw,90px);
  }

  .amount-control {
    width: min(100%,230px);
  }

  .tools {
    margin-top: 34px;
  }

}

@media (max-height:700px) {

  .players {
    gap: 26px;
  }

  .score {
    min-height: 72px;
  }

  .amount-control {
    margin-top: 12px;
  }

  .tools {
    margin-top: 24px;
  }

}

@media (prefers-reduced-motion:reduce) {

  *,
  *::before,
  *::after {
    animation-duration:.01ms !important;
    animation-iteration-count:1 !important;
    transition-duration:.01ms !important;
  }

}

</style>
</head>


<body>

<main class="app">

  <!-- TOP BAR -->

  <header class="topbar">

    <button
      class="icon-button"
      id="fullscreenButton"
      aria-label="Schermo intero"
    >
      ▧
    </button>

    <input
      id="titleInput"
      class="title-input"
      type="text"
      value=""
      aria-label="Titolo"
      autocomplete="off"
    >

    <button
      class="icon-button"
      id="resetButton"
      aria-label="Reset"
    >
      ↻
    </button>

  </header>


  <!-- PLAYERS -->

  <section class="players">


    <!-- PLAYER 1 -->

    <article
      class="player"
      data-player="0"
    >

      <div class="player-name">
        PLAYER 1
      </div>

      <div
        class="score"
        id="score-0"
        aria-live="polite"
      >
        8000
      </div>

      <div class="amount-control">

        <button
          class="amount-button"
          data-action="subtract"
          data-player="0"
          aria-label="Sottrai"
        >
          −
        </button>

        <input
          class="amount-input"
          data-player="0"
          type="number"
          min="1"
          step="1"
          value="500"
          inputmode="numeric"
          aria-label="Quantità"
        >

        <button
          class="amount-button"
          data-action="add"
          data-player="0"
          aria-label="Aggiungi"
        >
          +
        </button>

      </div>

    </article>


    <!-- PLAYER 2 -->

    <article
      class="player"
      data-player="1"
    >

      <div class="player-name">
        PLAYER 2
      </div>

      <div
        class="score"
        id="score-1"
        aria-live="polite"
      >
        8000
      </div>

      <div class="amount-control">

        <button
          class="amount-button"
          data-action="subtract"
          data-player="1"
          aria-label="Sottrai"
        >
          −
        </button>

        <input
          class="amount-input"
          data-player="1"
          type="number"
          min="1"
          step="1"
          value="500"
          inputmode="numeric"
          aria-label="Quantità"
        >

        <button
          class="amount-button"
          data-action="add"
          data-player="1"
          aria-label="Aggiungi"
        >
          +
        </button>

      </div>

    </article>

  </section>


  <!-- TOOLS -->

  <nav
    class="tools"
    aria-label="Strumenti"
  >

    <button
      class="tool-button"
      id="diceButton"
      aria-label="Lancia dado"
    >
      <span class="tool-icon">⚄</span>
    </button>

    <button
      class="tool-button"
      id="coinButton"
      aria-label="Lancia moneta"
    >
      <span class="tool-icon">◉</span>
    </button>

    <button
      class="tool-button"
      id="randomButton"
      aria-label="Numero casuale"
    >
      <span class="tool-icon">☷</span>
    </button>

    <button
      class="tool-button"
      id="editButton"
      aria-label="Modifica"
    >
      <span class="tool-icon">✎</span>
    </button>

  </nav>

</main>


<!-- =====================================
     DICE MODAL
===================================== -->

<div
  class="overlay"
  id="diceOverlay"
  aria-hidden="true"
>

  <div class="game-modal">

    <button
      class="modal-close"
      data-close="diceOverlay"
      aria-label="Chiudi"
    >
      ×
    </button>

    <div class="modal-title">
      DADO
    </div>

    <div class="dice-scene">

      <div class="dice" id="dice">

        <span class="dice-face dice-front">
          ⚄
        </span>

        <span class="dice-face dice-back">
          ⚂
        </span>

        <span class="dice-face dice-right">
          ⚅
        </span>

        <span class="dice-face dice-left">
          ⚁
        </span>

        <span class="dice-face dice-top">
          ⚃
        </span>

        <span class="dice-face dice-bottom">
          ⚀
        </span>

      </div>

    </div>

    <div
      class="result"
      id="diceResult"
    >
      —
    </div>

    <button
      class="primary-button"
      id="rollDice"
    >
      LANCIA
    </button>

  </div>

</div>


<!-- =====================================
     COIN MODAL
===================================== -->

<div
  class="overlay"
  id="coinOverlay"
  aria-hidden="true"
>

  <div class="game-modal">

    <button
      class="modal-close"
      data-close="coinOverlay"
      aria-label="Chiudi"
    >
      ×
    </button>

    <div class="modal-title">
      MONETA
    </div>

    <div class="coin-scene">

      <div
        class="coin"
        id="coin"
      >

        <div class="coin-side coin-heads">
          <span>H</span>
        </div>

        <div class="coin-side coin-tails">
          <span>T</span>
        </div>

      </div>

    </div>

    <div
      class="result"
      id="coinResult"
    >
      —
    </div>

    <button
      class="primary-button"
      id="flipCoin"
    >
      LANCIA
    </button>

  </div>

</div>


<!-- =====================================
     RANDOM MODAL
===================================== -->

<div
  class="overlay"
  id="randomOverlay"
  aria-hidden="true"
>

  <div class="game-modal">

    <button
      class="modal-close"
      data-close="randomOverlay"
      aria-label="Chiudi"
    >
      ×
    </button>

    <div class="modal-title">
      CASUALE
    </div>

    <div class="random-settings">

      <div class="number-field">

        <label for="randomMin">
          MIN
        </label>

        <input
          id="randomMin"
          type="number"
          value="1"
        >

      </div>


      <div class="number-field">

        <label for="randomMax">
          MAX
        </label>

        <input
          id="randomMax"
          type="number"
          value="100"
        >

      </div>

    </div>

    <div
      class="result large-result"
      id="randomResult"
    >
      —
    </div>

    <button
      class="primary-button"
      id="generateRandom"
    >
      GENERA
    </button>

  </div>

</div>


<!-- =====================================
     EDIT MODAL
===================================== -->

<div
  class="overlay"
  id="editOverlay"
  aria-hidden="true"
>

  <div class="game-modal">

    <button
      class="modal-close"
      data-close="editOverlay"
      aria-label="Chiudi"
    >
      ×
    </button>

    <div class="modal-title">
      MODIFICA
    </div>

    <div class="edit-fields">

      <label>

        PLAYER 1

        <input
          id="playerName0"
          type="text"
          value="PLAYER 1"
        >

      </label>

      <label>

        PLAYER 2

        <input
          id="playerName1"
          type="text"
          value="PLAYER 2"
        >

      </label>

    </div>

    <button
      class="primary-button"
      id="saveEdit"
    >
      SALVA
    </button>

  </div>

</div>


<script>

"use strict";


/* =========================================
   STATE
========================================= */

const INITIAL_SCORE = 8000;

const state = {

  players: [

    {
      name: "PLAYER 1",
      score: INITIAL_SCORE
    },

    {
      name: "PLAYER 2",
      score: INITIAL_SCORE
    }

  ],

  dice: {

    rolling: false,

    rotationX: 0,
    rotationY: 0,
    rotationZ: 0,

    timer: null

  },

  coin: {

    flipping: false,

    rotation: 0,

    timer: null

  }

};


/* =========================================
   DOM HELPERS
========================================= */

const $ = selector =>
  document.querySelector(selector);

const $$ = selector =>
  [...document.querySelectorAll(selector)];


const scoreElements = [
  $("#score-0"),
  $("#score-1")
];

const playerElements = [
  document.querySelector(
    '[data-player="0"] .player-name'
  ),

  document.querySelector(
    '[data-player="1"] .player-name'
  )
];

const amountInputs = [
  document.querySelector(
    '.amount-input[data-player="0"]'
  ),

  document.querySelector(
    '.amount-input[data-player="1"]'
  )
];


/* =========================================
   RANDOMNESS
========================================= */

function randomInt(min, max) {

  min = Math.ceil(min);
  max = Math.floor(max);

  if (max < min) {
    [min, max] = [max, min];
  }

  /*
   * Usa crypto quando disponibile.
   *
   * Questo evita una distribuzione basata
   * solamente su Math.random().
   */

  if (
    window.crypto &&
    typeof window.crypto.getRandomValues ===
      "function"
  ) {

    const range =
      max - min + 1;

    const MAX_UINT =
      0xFFFFFFFF;

    const limit =
      MAX_UINT -
      (MAX_UINT % range);

    const buffer =
      new Uint32Array(1);

    let value;

    do {

      window.crypto.getRandomValues(
        buffer
      );

      value = buffer[0];

    } while (
      value >= limit
    );

    return min +
      (value % range);
  }

  return Math.floor(
    Math.random() *
      (max - min + 1)
  ) + min;
}


/* =========================================
   SCORE
========================================= */

function sanitizeAmount(value) {

  const parsed =
    Number(value);

  if (
    !Number.isFinite(parsed)
  ) {
    return 0;
  }

  return Math.max(
    0,
    Math.floor(
      Math.abs(parsed)
    )
  );
}


function updateScore(
  playerIndex,
  amount
) {

  const player =
    state.players[playerIndex];

  if (!player) {
    return;
  }

  const safeAmount =
    sanitizeAmount(amount);

  if (safeAmount <= 0) {
    return;
  }

  if (amount > 0) {

    player.score +=
      safeAmount;

  } else {

    player.score -=
      safeAmount;

  }

  renderScore(
    playerIndex
  );
}


function renderScore(
  playerIndex
) {

  const player =
    state.players[playerIndex];

  const element =
    scoreElements[playerIndex];

  if (!player || !element) {
    return;
  }

  element.textContent =
    player.score.toLocaleString(
      "it-IT"
    );

  /*
   * Riavvio sicuro dell'animazione.
   */

  element.classList.remove(
    "bump"
  );

  void element.offsetWidth;

  element.classList.add(
    "bump"
  );
}


function getAmount(
  playerIndex
) {

  const input =
    amountInputs[playerIndex];

  if (!input) {
    return 0;
  }

  return sanitizeAmount(
    input.value
  );
}


/* =========================================
   +/- CONTROLS
========================================= */

$$(".amount-button")
.forEach(button => {

  button.addEventListener(
    "click",
    () => {

      const playerIndex =
        Number(
          button.dataset.player
        );

      const action =
        button.dataset.action;

      const amount =
        getAmount(
          playerIndex
        );

      if (amount <= 0) {
        return;
      }

      updateScore(

        playerIndex,

        action === "add"
          ? amount
          : -amount

      );

    }
  );

});


/* =========================================
   OVERLAY
========================================= */

function openOverlay(
  overlay
) {

  if (!overlay) {
    return;
  }

  overlay.classList.add(
    "open"
  );

  overlay.setAttribute(
    "aria-hidden",
    "false"
  );
}


function closeOverlay(
  overlay
) {

  if (!overlay) {
    return;
  }

  overlay.classList.remove(
    "open"
  );

  overlay.setAttribute(
    "aria-hidden",
    "true"
  );
}


/* =========================================
   DICE
========================================= */

const diceOverlay =
  $("#diceOverlay");

const dice =
  $("#dice");

const diceResult =
  $("#diceResult");

const rollDiceButton =
  $("#rollDice");


/*
 * Orientamento finale del dado.
 */

const diceRotations = {

  1: {
    x: 0,
    y: 0
  },

  2: {
    x: 0,
    y: -90
  },

  3: {
    x: 90,
    y: 0
  },

  4: {
    x: -90,
    y: 0
  },

  5: {
    x: 0,
    y: 180
  },

  6: {
    x: 0,
    y: 90
  }

};


function rollDice() {

  /*
   * Impedisce click multipli durante
   * lo stesso lancio.
   */

  if (
    state.dice.rolling
  ) {
    return;
  }

  state.dice.rolling =
    true;

  rollDiceButton.disabled =
    true;

  diceResult.textContent =
    "…";


  const result =
    randomInt(1, 6);


  const target =
    diceRotations[result];


  /*
   * Numero casuale di giri.
   *
   * Il dado non percorre sempre
   * la stessa identica traiettoria.
   */

  const extraX =
    randomInt(3, 5) * 360;

  const extraY =
    randomInt(3, 5) * 360;

  const extraZ =
    randomInt(1, 2) * 360;


  state.dice.rotationX +=
    extraX + target.x;

  state.dice.rotationY +=
    extraY + target.y;

  state.dice.rotationZ +=
    extraZ;


  dice.style.transform = `
    rotateX(${state.dice.rotationX}deg)
    rotateY(${state.dice.rotationY}deg)
    rotateZ(${state.dice.rotationZ}deg)
  `;


  /*
   * Il timer precedente viene sempre
   * cancellato.
   *
   * In questo modo non si possono
   * accumulare animazioni fantasma.
   */

  clearTimeout(
    state.dice.timer
  );


  state.dice.timer =
    setTimeout(() => {

      state.dice.rolling =
        false;

      rollDiceButton.disabled =
        false;

      diceResult.textContent =
        String(result);

    }, 940);

}


$("#diceButton")
.addEventListener(
  "click",
  () => {

    openOverlay(
      diceOverlay
    );

  }
);


rollDiceButton
.addEventListener(
  "click",
  rollDice
);


/* =========================================
   COIN
========================================= */

const coinOverlay =
  $("#coinOverlay");

const coin =
  $("#coin");

const coinResult =
  $("#coinResult");

const flipCoinButton =
  $("#flipCoin");


function flipCoin() {

  if (
    state.coin.flipping
  ) {
    return;
  }

  state.coin.flipping =
    true;

  flipCoinButton.disabled =
    true;

  coinResult.textContent =
    "…";


  /*
   * 0 = TESTA
   * 1 = CROCE
   */

  const result =
    randomInt(0, 1);


  /*
   * Tra 6 e 9 giri completi.
   *
   * Questo rende il lancio più naturale
   * e non ripetitivo.
   */

  const extraTurns =
    randomInt(6, 9) * 360;


  const finalRotation =
    result === 0
      ? 0
      : 180;


  state.coin.rotation +=
    extraTurns +
    finalRotation;


  coin.style.transform =
    `rotateY(${state.coin.rotation}deg)`;


  clearTimeout(
    state.coin.timer
  );


  state.coin.timer =
    setTimeout(() => {

      state.coin.flipping =
        false;

      flipCoinButton.disabled =
        false;

      coinResult.textContent =
        result === 0
          ? "TESTA"
          : "CROCE";

    }, 1200);

}


$("#coinButton")
.addEventListener(
  "click",
  () => {

    openOverlay(
      coinOverlay
    );

  }
);


flipCoinButton
.addEventListener(
  "click",
  flipCoin
);


/* =========================================
   RANDOM NUMBER
========================================= */

const randomOverlay =
  $("#randomOverlay");

const randomResult =
  $("#randomResult");

const randomMin =
  $("#randomMin");

const randomMax =
  $("#randomMax");

const generateRandomButton =
  $("#generateRandom");


function generateRandomNumber() {

  let min =
    Number(
      randomMin.value
    );

  let max =
    Number(
      randomMax.value
    );


  if (
    !Number.isFinite(min) ||
    !Number.isFinite(max)
  ) {
    return;
  }


  min =
    Math.floor(min);

  max =
    Math.floor(max);


  if (min > max) {

    [min, max] =
      [max, min];

  }


  const result =
    randomInt(
      min,
      max
    );


  randomResult.textContent =
    result.toLocaleString(
      "it-IT"
    );

}


$("#randomButton")
.addEventListener(
  "click",
  () => {

    openOverlay(
      randomOverlay
    );

  }
);


generateRandomButton
.addEventListener(
  "click",
  generateRandomNumber
);


/* =========================================
   EDIT
========================================= */

const editOverlay =
  $("#editOverlay");

const playerNameInputs = [

  $("#playerName0"),

  $("#playerName1")

];


function savePlayerNames() {

  playerNameInputs
  .forEach(
    (input, index) => {

      const value =
        input.value.trim();

      if (!value) {
        return;
      }

      state.players[index].name =
        value.toUpperCase();

      playerElements[index]
        .textContent =
        state.players[index].name;

    }
  );


  closeOverlay(
    editOverlay
  );
}


$("#editButton")
.addEventListener(
  "click",
  () => {

    playerNameInputs
    .forEach(
      (input, index) => {

        input.value =
          state.players[index].name;

      }
    );

    openOverlay(
      editOverlay
    );

  }
);


$("#saveEdit")
.addEventListener(
  "click",
  savePlayerNames
);


/* =========================================
   RESET
========================================= */

$("#resetButton")
.addEventListener(
  "click",
  () => {

    const confirmed =
      window.confirm(
        "Vuoi riportare entrambi i giocatori a 8000?"
      );

    if (!confirmed) {
      return;
    }


    state.players
      .forEach(
        player => {

          player.score =
            INITIAL_SCORE;

        }
      );


    renderScore(0);
    renderScore(1);

  }
);


/* =========================================
   FULLSCREEN
========================================= */

$("#fullscreenButton")
.addEventListener(
  "click",
  async () => {

    try {

      if (
        !document.fullscreenElement
      ) {

        await document
          .documentElement
          .requestFullscreen();

      } else {

        await document
          .exitFullscreen();

      }

    } catch (error) {

      console.warn(
        "Fullscreen non disponibile:",
        error
      );

    }

  }
);


/* =========================================
   CLOSE BUTTONS
========================================= */

$$("[data-close]")
.forEach(button => {

  button.addEventListener(
    "click",
    () => {

      const overlay =
        document.getElementById(
          button.dataset.close
        );

      closeOverlay(
        overlay
      );

    }
  );

});


/* =========================================
   CLICK OUTSIDE MODAL
========================================= */

$$(".overlay")
.forEach(overlay => {

  overlay.addEventListener(
    "click",
    event => {

      if (
        event.target === overlay
      ) {

        closeOverlay(
          overlay
        );

      }

    }
  );

});


/* =========================================
   ESC
========================================= */

document.addEventListener(
  "keydown",
  event => {

    if (
      event.key !== "Escape"
    ) {
      return;
    }

    $$(".overlay.open")
    .forEach(
      closeOverlay
    );

  }
);


/* =========================================
   AMOUNT INPUT
========================================= */

$$(".amount-input")
.forEach(input => {

  input.addEventListener(
    "input",
    () => {

      const value =
        sanitizeAmount(
          input.value
        );

      if (value <= 0) {
        input.value = "";
      }

    }
  );

});


/* =========================================
   TITLE
========================================= */

const titleInput =
  $("#titleInput");


titleInput.addEventListener(
  "input",
  () => {

    document.title =
      titleInput.value.trim()
        || "Players";

  }
);


/* =========================================
   INITIAL RENDER
========================================= */

renderScore(0);
renderScore(1);

</script>

</body>
</html>
